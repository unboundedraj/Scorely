# Scorely environment variables
# Copy to .env.local and fill in. Restart `npm run dev` after changing them.
# Without these the app still works in on-device mode (no accounts / live sharing).

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Either the new publishable key (sb_publishable_…) or the legacy anon key works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── Optional ──────────────────────────────────────────────────────────────────
# Public URL of this app (used for share-card metadata). Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed for `npm run db:push` (applies supabase/migrations/*.sql).
# Project Settings → Database → Connection string (URI). Never expose this to the browser.
SUPABASE_DB_URL=
